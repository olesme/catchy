<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- xUnit v3 requires .NET 8+; netstandard2.0 is intentionally excluded -->
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
		<AssemblyName>Catchy.XUnit</AssemblyName>
		<RootNamespace>Catchy.XUnit</RootNamespace>
		<PackageId>Catchy.XUnit</PackageId>
		<Description>Catchy integration package for xUnit v3 with fluent assertion integration.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Catchy\Catchy.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
