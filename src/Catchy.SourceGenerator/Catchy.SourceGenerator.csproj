<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFramework>netstandard2.0</TargetFramework>
	<LangVersion>14</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<IsRoslynComponent>true</IsRoslynComponent>
	<AssemblyName>Catchy.SourceGenerator</AssemblyName>
	<PackageId>Catchy.SourceGenerator</PackageId>
	<RootNamespace>Catchy.SourceGenerator</RootNamespace>
	<Description>Roslyn source generator for Catchy custom assertions and typed assertion-surface emission.</Description>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	<NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
	<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
	<Compile Include="..\Catchy\Polyfills\IsExternalInit.cs" Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>

  <ItemGroup>
	<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	<None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
