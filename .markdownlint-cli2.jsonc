{
  "config": {
    "default": true,
    // Phase 1 baseline: keep lint active while allowing incremental cleanup
    "MD010": true,
    "MD013": {
      "line_length": 180,
      "code_blocks": false,
      "tables": false
    },
    "MD031": true,
    "MD032": true,
    "MD033": true,
    "MD040": true,
    "MD041": true
  },
  "ignores": [
    "docs/archive/**",
    "**/bin/**",
    "**/obj/**",
    ".vs/**",
    ".tools/.store/**"
  ]
}
